# Dependencies are never committed.
#
# Note: no trailing slash. This directory is usually a SYMLINK to the hosting
# profile's dependency store (e.g. ~/.dsh/profiles/node_modules), and git treats
# a symlink as a file — `node_modules/` would NOT match it.
node_modules

# macOS / editor noise
.DS_Store
*.log
.idea/
.vscode/

# No lockfile is committed on purpose: the harness peers are published under the
# `next` dist-tag and the ranges in package.json select them (see ci.yml). Ignore
# it so a local `npm install` cannot become an accidental commit.
package-lock.json
