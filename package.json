{
  "name": "dsh-plugin-subagent-roles",
  "version": "0.1.0",
  "description": "File-defined subagent roles for DeepSeek Harness: project (.dsh/roles) and global (~/.dsh/roles) role files, a compact role catalog, and real per-role tool filtering.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.5-rc.2 <0.2.0-0 || >=0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.2.0-0 || >=0.2.0-0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.5-rc.2 <0.2.0-0 || >=0.2.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/troytse/dsh-plugin-subagent-roles.git"
  },
  "bugs": {
    "url": "https://github.com/troytse/dsh-plugin-subagent-roles/issues"
  },
  "homepage": "https://github.com/troytse/dsh-plugin-subagent-roles",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "subagent",
    "roles"
  ],
  "license": "MIT"
}
